---
import type { Routes } from '@app/api/types'
import { localization, pathLocale } from '@app/api/i18n'

interface Props {
  routes?: Routes
}

const { routes } = Astro.props

const { locales } = localization

const { pathname } = Astro.url
const currentLocale = pathLocale(pathname)

const route =
  routes &&
  Object.values(routes).find((route) => {
    return route.locales[currentLocale].path === pathname
  })
---

<ul class="locales-menu">
  {
    locales.map((locale) => (
      <li class="locales-menu__item">
        {locale === currentLocale ? (
          <span>{locale}</span>
        ) : (
          <a href={route ? route.locales[locale].path : `/${locale}`}>{locale}</a>
        )}
      </li>
    ))
  }
</ul>

<style lang="scss">
  @use '../styles/utilities' as *;

  .locales-menu {
    --gap: var(--space-4);

    display: flex;
    flex-direction: row;
    gap: var(--gap);

    &__item {
      text-transform: uppercase;

      span {
        font-weight: var(--font-weight-bold);
        color: var(--color-teal-00);
      }

      a {
        font-weight: var(--font-weight-normal);
        @include transition(font-weight);
        text-decoration: none;

        &:hover {
          font-weight: var(--font-weight-bold);
        }
      }

      &:not(:last-child) {
        &:after {
          content: '/';
          margin-left: var(--gap);
        }
      }
    }
  }
</style>
