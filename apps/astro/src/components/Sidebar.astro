---
import LogoMain from '@/assets/svgs/logo-main.svg'
import ArrowDown from '@/assets/svgs/arrow-down.svg'
import ArrowLeft from '@/assets/svgs/arrow-left.svg'
import type { General, PageSlug } from '@app/api/types'

interface Props {
  navigation?: General.Navigation
  slug?: PageSlug
  parentSlug?: PageSlug
}

const { navigation, slug, parentSlug } = Astro.props
---

<aside class="sidebar">
  <div class="container">
    <div class="header">
      <a
        class="logo"
        href={navigation?.home?.url ?? '/'}
        aria-label={navigation?.home?.linkLabel ?? 'Accueil'}
      >
        <LogoMain />
      </a>
    </div>

    <div class="footer">
      {navigation?.menu && (
        <nav class="menu">
          <ul class="menu__list" data-menu>
            {navigation?.menu.map(({ title, url, slug: itemSlug }) => {
              const isActive = slug === itemSlug
              const hasParent = !!parentSlug && itemSlug === parentSlug
              return (
                <li class="menu__item">
                  <a
                    class:list={['menu__link', isActive && 'active', hasParent && 'has-parent']}
                    href={url}
                    data-menu-item
                    data-slug={itemSlug}
                  >
                    {hasParent && (
                      <span class="menu__back-icon">
                        <ArrowLeft />
                      </span>
                    )}
                    <span>{title}</span>
                  </a>
                </li>
              )
            })}
          </ul>
        </nav>
      )}

      <div class="actions">
        <button class="action action__scroll">
          <ArrowDown />
        </button>
      </div>
    </div>
  </div>
</aside>

<script>
  import { initScrollButton } from '@/lib/scroll'

  document.addEventListener('astro:page-load', () => {
    initScrollButton('.action__scroll')
  })
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .sidebar {
    --padding-bottom: 0;

    padding: var(--layout-padding-y) var(--layout-padding-x);
    padding-bottom: var(--padding-bottom);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: pxToRem(240px);
    flex-shrink: 0;
    width: 100%;
  }

  .container {
    display: flex;
    flex-direction: row;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) max-content;
    flex-grow: 1;
    gap: var(--space-48);
    align-items: baseline;
  }

  .logo {
    --width: #{pxToRem(120px)};
    vertical-align: -0.4em;

    :global(svg) {
      max-width: var(--width);
      width: 100%;
    }
  }

  .footer {
    display: flex;
    gap: var(--space-16);
    flex-direction: column;
  }

  .menu {
    $menu: &;

    align-content: end;
    flex-grow: 1;

    &__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      align-items: start;
    }

    &__link {
      --active-color: var(--body-color);
      display: inline-block;
      color: var(--color-teal-600);
      text-decoration: none;
      @include transition('color, transform');
      position: relative;

      &:hover {
        color: var(--active-color);

        #{$menu}__back-icon {
          transform: translateY(-50%) translateX(calc(-1 * var(--space-4)));
        }
      }

      &.active {
        color: var(--active-color);
        pointer-events: none;
        cursor: default;

        &:before {
          content: '';
          display: block;
          width: pxToRem(12px);
          height: pxToRem(1px);
          background-color: var(--color-teal-600);
          position: absolute;
          bottom: 0.5em;
          right: calc(100% + var(--space-8));
        }
      }

      &.has-parent {
        color: var(--active-color);
      }
    }

    &__back-icon {
      position: absolute;
      right: 100%;
      padding-right: var(--space-8);
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      @include transition(transform);
    }
  }

  .actions {
    align-content: end;
  }

  .action {
    color: var(--color-teal-600);
    @include transition('color, opacity');
    cursor: pointer;

    &:hover {
      color: var(--body-color);
    }

    &__scroll {
      :global(svg) {
        pointer-events: none;
        @include transition(transform);
      }

      &:hover {
        :global(svg) {
          transform: translateY(#{pxToRem(4px)});
        }
      }

      &:not([data-scroll]) {
        opacity: 0;
        pointer-events: none;
      }
    }
  }

  @include until(desktop) {
    .actions {
      display: none;
    }
  }

  @include from(desktop) {
    .sidebar {
      --padding-bottom: var(--content-padding-bottom) width: auto;
    }

    .container {
      flex-direction: column;
      justify-content: space-between;
    }

    .header {
      grid-column: span 2;
      position: sticky;
      top: var(--layout-padding-y);
    }

    .menu {
      position: relative;
    }

    .logo {
      --width: #{pxToRem(180px)};
    }

    .footer {
      flex-direction: row;
      position: sticky;
      bottom: var(--content-padding-bottom);
    }
  }
</style>
