---
import LogoMain from '@/assets/svgs/logo-main.svg'
import ArrowDown from '@/assets/svgs/arrow-down.svg'
import type { General, PageSlug } from '@app/api/types'

interface Props {
  navigation?: General.Navigation
  slug?: PageSlug
  parentSlug?: PageSlug
}

const { navigation, slug, parentSlug } = Astro.props
---

<aside class="sidebar">
  <div class="container">
    <div class="header">
      <a
        class="logo"
        href={navigation?.home?.url ?? '/'}
        aria-label={navigation?.home?.linkLabel ?? 'Accueil'}
      >
        <LogoMain />
      </a>
    </div>

    {
      navigation?.menu && (
        <nav class="menu">
          <ul class="menu__list" data-menu>
            {navigation?.menu.map(({ title, url, slug: itemSlug }) => (
              <li class="menu__item">
                <a
                  class:list={[
                    'menu__link',
                    (slug === itemSlug || parentSlug === itemSlug) && 'active',
                  ]}
                  href={url}
                  data-menu-item
                  data-slug={itemSlug}
                >
                  {title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="actions">
      <button class="action action__scroll" data-scroll="[data-scroll-view]">
        <ArrowDown />
      </button>
    </div>
  </div>
</aside>

<style lang="scss">
  @use '../styles/utilities' as *;

  .sidebar {
    padding: var(--content-padding-y) var(--content-padding-x);
    display: flex;
    flex-direction: column;
    height: 100dvh;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    width: pxToRem(240px);
  }

  .container {
    flex-grow: 1;
    display: grid;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) max-content;
  }

  .header {
    grid-column: span 2;
  }

  .logo {
    --width: #{pxToRem(180px)};

    :global(svg) {
      max-width: var(--width);
      width: 100%;
    }
  }

  .menu {
    align-content: end;
    &__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    &__item {
    }

    &__link {
      color: var(--color-teal-600);
      text-decoration: none;

      &:hover {
        color: var(--color-teal-950);
      }
    }
  }

  .actions {
    align-content: end;
  }

  .action {
    color: var(--color-teal-600);
    @include transition(color);
    cursor: pointer;

    &:hover {
      color: var(--color-teal-950);
    }

    &__scroll {
      :global(svg) {
        pointer-events: none;
        @include transition(transform);
      }

      &:hover {
        :global(svg) {
          transform: translateY(#{pxToRem(4px)});
        }
      }
    }
  }
</style>
