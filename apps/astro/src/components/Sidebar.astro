---
import LogoMain from '@/assets/svgs/logo-main.svg'
import ArrowDown from '@/assets/svgs/arrow-down.svg'
import type { General, PageSlug } from '@app/api/types'

interface Props {
  navigation?: General.Navigation
  slug?: PageSlug
  parentSlug?: PageSlug
}

const { navigation, slug, parentSlug } = Astro.props
---

<aside class="sidebar">
  <div class="container">
    <div class="header">
      <a
        class="logo"
        href={navigation?.home?.url ?? '/'}
        aria-label={navigation?.home?.linkLabel ?? 'Accueil'}
      >
        <LogoMain />
      </a>
    </div>

    {navigation?.menu && (
      <nav class="menu">
        <ul class="menu__list" data-menu>
          {navigation?.menu.map(({ title, url, slug: itemSlug }) => {
            const isActive = slug === itemSlug || parentSlug === itemSlug
            const hasParent = !!parentSlug
            return (
              <li class="menu__item">
                <a
                  class:list={['menu__link', isActive && 'active']}
                  href={url}
                  data-menu-item
                  data-slug={itemSlug}
                >
                  <span>{title}</span>
                </a>
              </li>
            )
          })}
        </ul>
      </nav>
    )}

    <div class="actions">
      <button class="action action__scroll">
        <ArrowDown />
      </button>
    </div>
  </div>
</aside>

<script>
  import { initScrollButton } from '@/lib/scroll'

  document.addEventListener('astro:page-load', () => {
    initScrollButton('.action__scroll')
  })
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .sidebar {
    padding: var(--layout-padding-y) var(--layout-padding-x);
    padding-bottom: var(--content-padding-bottom);
    display: flex;
    flex-direction: column;
    height: 100dvh;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    width: pxToRem(240px);
    flex-shrink: 0;
  }

  .container {
    flex-grow: 1;
    display: grid;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) max-content;
  }

  .header {
    grid-column: span 2;
    position: sticky;
    top: var(--layout-padding-y);
  }

  .logo {
    --width: #{pxToRem(180px)};

    :global(svg) {
      max-width: var(--width);
      width: 100%;
    }
  }

  .menu {
    align-content: end;

    &__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    &__item {
    }

    &__link {
      display: inline-block;
      color: var(--color-teal-600);
      text-decoration: none;
      @include transition('color, transform');
      position: relative;

      &:hover {
        color: var(--body-color);
      }

      &.active {
        color: var(--body-color);

        &:before {
          content: '';
          display: block;
          width: pxToRem(12px);
          height: pxToRem(1px);
          background-color: var(--color-teal-600);
          position: absolute;
          bottom: 0.5em;
          right: calc(100% + var(--space-8));
        }
      }

      &:not(.active) {
        &:hover {
          // transform: translateX(4px);
        }
      }
    }
  }

  .actions {
    align-content: end;
  }

  .action {
    color: var(--color-teal-600);
    @include transition('color, opacity');
    cursor: pointer;

    &:hover {
      color: var(--body-color);
    }

    &__scroll {
      :global(svg) {
        pointer-events: none;
        @include transition(transform);
      }

      &:hover {
        :global(svg) {
          transform: translateY(#{pxToRem(4px)});
        }
      }

      &:not([data-scroll]) {
        opacity: 0;
        pointer-events: none;
      }
    }
  }
</style>
