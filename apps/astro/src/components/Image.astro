---
type Fit = 'fill' | 'contain'

type Props = {
  src?: string | null | undefined
  alt?: string
  srcset?: {
    [size: string]: string
  }
  loading?: HTMLImageElement['loading']
  sizes?: HTMLImageElement['sizes']
  class?: string
  fit?: Fit
  style?: string
  fetchpriority?: 'high' | 'auto' | 'low' | null | undefined
  decoding?: HTMLImageElement['decoding']
}

const {
  src,
  alt,
  srcset = {},
  loading = 'lazy',
  sizes = '100w',
  class: className,
  fit = 'fill',
  style,
  fetchpriority,
  decoding,
} = Astro.props

const mediaUrl = process.env.MEDIA_URL

const formatSrc = (src: string) => `${mediaUrl}${src}`
---

{
  src && (
    <div class:list={['wrapper', className, fit]}>
      <img
        src={formatSrc(src)}
        srcset={Object.keys(srcset)
          .map((key) => `${formatSrc(srcset[key])} ${key}`)
          .join(',')}
        sizes={sizes}
        alt={alt}
        class="image"
        loading={loading}
        style={style}
        fetchpriority={fetchpriority}
        decoding={decoding}
        data-load
      />
    </div>
  )
}

<script>
  const initImages = () => {
    const images = document.querySelectorAll<HTMLImageElement>('img[data-load]')
    images.forEach((image) => {
      if (image.complete) {
        image.setAttribute('load', 'complete')
      }

      image.addEventListener(
        'load',
        () => {
          image.setAttribute('load', 'complete')
        },
        { once: true },
      )
    })
  }

  document.addEventListener('astro:page-load', () => {
    initImages()
  })

  document.addEventListener('images:load', () => {
    initImages()
  })
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .wrapper {
    width: 100%;
    height: 100%;
    background-color: var(--color-gray-80);
  }

  .image {
    display: block;
    width: 100%;
    opacity: 0;
    @include transition(opacity);

    &[load='complete'] {
      opacity: 1;
    }
  }

  .fill {
    .image {
      object-fit: cover;
      height: 100%;
    }
  }

  .contain {
    .image {
      object-fit: contain;
      height: 100%;
    }
  }
</style>
