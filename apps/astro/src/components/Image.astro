---
import type { Partner } from '@app/api/types'
import { undefined } from 'astro:schema'

type Fit = 'fill' | 'contain'

type Props = {
  src?: string | null | undefined
  alt?: string
  srcset?: {
    [size: string]: string
  }
  loading?: HTMLImageElement['loading']
  sizes?: HTMLImageElement['sizes']
  class?: string
  fit?: Fit
  style?: string
  fetchpriority?: 'high' | 'auto' | 'low' | null | undefined
  decoding?: HTMLImageElement['decoding']
  width?: number | string | null
  height?: number | string | null
  credit?: Partner
}

const {
  src,
  alt,
  srcset = {},
  loading = 'lazy',
  sizes = '100w',
  class: className,
  style = '',
  fit = 'fill',
  fetchpriority,
  decoding,
  width,
  height,
  credit,
} = Astro.props

const mediaUrl = process.env.MEDIA_URL

const formatSrc = (src: string) => `${mediaUrl}${src}`
---

{src && (
  <div
    class:list={['wrapper', className, fit]}
    style={width && height ? `--image-aspect-ratio: ${Number(width) / Number(height)}` : undefined}
  >
    <img
      src={formatSrc(src)}
      srcset={Object.keys(srcset)
        .map((key) => `${formatSrc(srcset[key])} ${key}`)
        .join(',')}
      sizes={sizes}
      alt={alt}
      class="image"
      loading={loading}
      style={style}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-load
    />
    {credit && (
      <div class="image-credit">
        <span class="image-credit__label">{credit.name}</span>
      </div>
    )}
  </div>
)}

<script>
  const initImages = () => {
    const images = document.querySelectorAll<HTMLImageElement>('img[data-load]')
    images.forEach((image) => {
      if (image.complete) {
        image.setAttribute('load', 'complete')
      }

      image.addEventListener(
        'load',
        () => {
          image.setAttribute('load', 'complete')
        },
        { once: true },
      )
    })
  }

  document.addEventListener('astro:page-load', () => {
    initImages()
  })

  document.addEventListener('images:load', () => {
    initImages()
  })
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .wrapper {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--image-aspect-ratio);
    background-color: var(--image-background-color);
    position: relative;

    &:hover {
      .image-credit {
        opacity: 1;
      }
    }
  }

  .image {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    @include transition(opacity);

    &[load='complete'] {
      opacity: 1;
    }
  }

  .fill {
    .image {
      object-fit: cover;
    }
  }

  .contain {
    width: auto;

    .image {
      object-fit: contain;
    }
  }

  .image-credit {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    box-sizing: border-box;
    display: flex;
    align-items: end;
    justify-content: end;
    padding: var(--space-4) var(--space-8);
    opacity: 0;
    @include transition(opacity, medium);

    &:before {
      --blur: 5px;
      content: '';
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-teal-600);
      opacity: 0.7;
      border-radius: 1px;
    }

    &__label {
      position: relative;
      color: var(--color-teal-200);

      &:before {
        content: '© ';
      }
    }
  }
</style>
