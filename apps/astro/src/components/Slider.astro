---
import Image from '@/components/Image.astro'
import TagList from '@/components/TagList.astro'
import ChevronLeft from '@/assets/svgs/chevron-left.svg'
import ChevronRight from '@/assets/svgs/chevron-right.svg'
import type { Home } from '@app/api/types'

export type Props = {
  projects: Home.Data['projects']
  slidesArialLabel: Home.Data['slidesArialLabel']
  prevAriaLabel?: string
  nextAriaLabel?: string
  controlAriaLabel?: string
}

const {
  projects,
  slidesArialLabel,
  prevAriaLabel = "Afficher l'image suivante",
  nextAriaLabel = "Afficher l'image précédente",
  controlAriaLabel = "Afficher l'image",
} = Astro.props
---

<div class="slider" aria-label={slidesArialLabel} data-slider>
  <div class="main">
    <div class="slides" aria-live="polite">
      {projects.map(({ image }, index) => (
        <div
          class="slide"
          data-slider-item
          data-slider-active="false"
          aria-hidden="true"
          data-slider-ariable
          inert
        >
          {image && (
            <Image
              src={image.url}
              alt={image.alt}
              srcset={{
                '800w': image.sizes?.[2000]?.url!,
                '1200w': image.sizes?.[3000]?.url!,
              }}
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          )}
        </div>
      ))}
    </div>
    <div class="remote">
      <div class="controls">
        <button class="control control__prev" data-slider-prev aria-label={prevAriaLabel}>
          <ChevronLeft />
        </button>
        <ul class="control-list">
          {Array.from(Array(projects.length)).map((_, index) => (
            <button
              class="control-list__item"
              aria-label={`${controlAriaLabel} ${index + 1}`}
              data-slider-goto={index}
              data-slider-active="false"
            />
          ))}
        </ul>
        <button class="control control__next" data-slider-next aria-label={nextAriaLabel}>
          <ChevronRight />
        </button>
      </div>
    </div>
  </div>
  <div class="footer">
    <div class="counter" aria-hidden>
      <span data-slider-counter>{'1'.padStart(2, '0')}</span>
      <span>{`${projects.length}`.padStart(2, '0')}</span>
    </div>
    <div class="cards" aria-live="polite">
      {projects.map(({ title, url, tags }, index) => (
        <article
          class="card"
          data-slider-card
          data-slider-active="false"
          aria-hidden="true"
          data-slider-ariable
          inert
          data-slider-pause
        >
          <h3>
            <a href={url} class="title">
              {title}
            </a>
          </h3>
          <TagList tags={tags} />
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  import Slider, { type SliderChangeDetail } from '@/lib/Slider'
  const slider = new Slider()

  document.addEventListener('astro:page-load', () => {
    const counter = document.querySelector('[data-slider-counter')
    if (counter) {
      slider.addEventListener('change', (event) => {
        const { current } = (event as CustomEvent<SliderChangeDetail>).detail
        counter.innerHTML = `${current + 1}`.padStart(2, '0')
      })
    }
    slider.launch()
  })
</script>

<style lang="scss">
  @use '../styles/utilities/' as *;

  .slider {
    --padding-right: var(--space-48);
    --control-color: var(--color-teal-500);
    --control-color-hover: var(--color-teal-800);

    $transition-time: medium;

    $slider: &;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    @include bleed();

    .main {
      display: flex;
    }

    .slides {
      width: 100%;
      position: relative;
      overflow: hidden;
      flex-grow: 1;
      height: calc(100dvh - var(--content-padding-top));
    }

    .slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      display: block;
      pointer-events: none;
      opacity: 0;
      @include transition(opacity, $transition-time);

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      &[data-slider-active='true'] {
        opacity: 1;
        pointer-events: auto;
      }
    }

    .remote {
      width: var(--padding-right);
      display: flex;
      flex-direction: column;
      justify-content: end;
      padding-bottom: var(--layout-padding-y);
    }

    .controls {
      display: flex;
      flex-direction: column;
      color: var(--control-color);
      align-items: center;
      gap: var(--space-8);
      @include transition(color);
    }

    .control {
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
      cursor: pointer;

      &:hover {
        color: var(--control-color-hover);
      }
    }

    .control-list {
      display: flex;
      flex-direction: column;
      align-items: center;

      &__item {
        padding: var(--space-4) 0;
        cursor: pointer;

        &:before {
          content: '';
          display: block;
          width: pxToRem(12px);
          height: pxToRem(1px);
          background-color: currentColor;
          @include transition(width);
        }

        &:hover {
          &:before {
            color: var(--control-color-hover);
          }
        }

        &[data-slider-active='true'] {
          &:before {
            width: pxToRem(16px);
            color: var(--control-color-hover);
          }
        }
      }
    }

    .footer {
      display: flex;
      flex-direction: row;
      justify-content: end;
      padding: var(--space-16) var(--padding-right) var(--layout-padding-y) var(--space-16);
    }

    .cards {
      position: relative;
      display: flex;
      flex-direction: row;
      justify-content: end;
      flex-grow: 1;
    }

    .card {
      top: 0;
      right: 0;
      pointer-events: none;
      opacity: 0;
      @include transition(opacity, $transition-time);
      display: flex;
      flex-direction: column;
      align-items: end;
      gap: var(--space-4);

      &[data-slider-active='true'] {
        opacity: 1;
        pointer-events: auto;
      }

      &:not(:first-child) {
        position: absolute;
      }
    }

    .title {
      @include heading(4);
      text-decoration: none;
      color: var(--color-teal-600);
      @include transition(color);

      &:hover {
        color: var(--body-color);
      }
    }

    .counter {
      --gap: var(--space-2);
      display: flex;
      gap: var(--gap);
      font-size: var(--font-size-xs);
      color: var(--color-teal-500);

      span {
        &:last-child {
          color: var(--color-teal-400);
          &:before {
            content: '/';
            margin-right: var(--gap);
          }
        }
      }
    }
  }
</style>
