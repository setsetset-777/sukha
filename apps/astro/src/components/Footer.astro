---
import LogoFooter from '@/assets/svgs/logo-footer.svg'
import LocalesMenu from '@/components/LocalesMenu.astro'
import type { General, Routes } from '@app/api/types'

type Props = General.Footer & {
  routes?: Routes
}

const { text, logoAlt, routes } = Astro.props
---

<footer class:list={['footer']}>
  <div class="container">
    <div class="sukha">
      <span class="logo" aria-label={logoAlt}>
        <LogoFooter />
      </span>
      {text && <p>{text}</p>}
    </div>
    <LocalesMenu routes={routes} />
  </div>
</footer>

<style lang="scss">
  @use '../styles/utilities' as *;

  .footer {
    background-color: var(--color-teal-800);
    color: var(--color-teal-300);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .container {
    --padding-x: var(--layout-padding-y);
    --padding-y: var(--space-48);
    padding: var(--padding-y) var(--padding-x);
    position: relative;
    display: flex;
    gap: var(--space-48);
    flex-direction: column;
    align-items: baseline;
    justify-content: space-between;
    max-width: var(--layout-max-width);
    width: 100%;
    box-sizing: border-box;
  }

  .sukha {
    display: flex;
    flex-direction: column;
    align-items: baseline;
    gap: var(--space-16);

    :global(svg) {
      position: relative;
      top: pxToRem(1px);
      color: var(--color-teal-200);
      width: pxToRem(85px);
    }

    p {
      color: var(--color-teal-300);
    }
  }

  @include from(mobile) {
    .container {
      --padding-y: var(--layout-padding-x);
      flex-direction: row;
      align-items: end;
      gap: var(--space-64);
    }

    .sukha {
      flex-direction: row;
      gap: var(--space-24);
    }
  }
</style>
