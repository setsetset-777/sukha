---
import '../styles/index.scss'

import { getPage } from '@/lib/page'
import NotFound from '@/layouts/NotFound.astro'
import Error from '@/layouts/Error.astro'
import Page from '@/layouts/Page.astro'

import type { PageData } from '@app/api/types'
import { getLocaleFromPath } from '@app/api/i18n'

const { path } = Astro.params

let page: PageData | null = null
let error = false

try {
  const locale = getLocaleFromPath(Astro.url.pathname)
  page = await getPage(`/${path ?? ''}?${Astro.url.searchParams.toString()}`, locale)
} catch (e) {
  console.error(e)
  error = true
  Astro.response.status = 500
}

if (!page) {
  Astro.response.status = 404
}
---

{error ? <Error /> : page ? <Page page={page} /> : <NotFound />}
