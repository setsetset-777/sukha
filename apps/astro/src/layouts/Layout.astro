---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import PageLoader from '@/components/PageLoader.astro'

import type { Meta, PageSlug } from '@app/api/types'
import { getGeneral } from '@/lib/page'

type Props = {
  meta: Meta
  noGeneral?: boolean
  slug?: PageSlug
  parentSlug?: PageSlug
}

const { meta, slug, noGeneral } = Astro.props

const general = !noGeneral ? await getGeneral() : null

const navigation = general?.navigation ?? undefined
const footer = general?.footer ?? undefined
---

<!doctype html>
<html lang="en">
  <Head meta={meta} />
  <body data-theme="light" class="body" data-slug={slug}>
    <div class="container">
      <main class="main">
        <slot />
      </main>
      <Footer {...footer} />
    </div>
    <PageLoader />
  </body>
</html>

<script>
  const scrollToElement = (selector?: string) => {
    if (!selector) return
    const target = document.querySelector(selector)
    target?.scrollIntoView()
  }

  const initScrollClicks = () => {
    document.addEventListener('click', ({ target }) => {
      if (!(target instanceof HTMLElement)) return
      if (target.closest('[data-scroll')) {
        const selector = target.dataset.scroll
        scrollToElement(selector)
      }
    })
  }

  const initScrollHash = () => {
    const match = window.location.hash.match(/^#[a-zA-Z0-9-_]+/)
    const selector = match && match[0]

    if (selector) {
      scrollToElement(selector)
    }
  }

  document.addEventListener('astro:page-load', () => {
    initScrollHash()
  })

  initScrollClicks()
</script>

<style lang="scss">
  html,
  body {
    background-color: var(--color-teal-00);
    color: var(--color-teal-950);
    font-family: var(--font-family-body);
    height: 100%;
    font-size: var(--font-size-s);
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    position: relative;
  }

  .container {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: stretch;
    overflow-x: clip;
    font-size: var(--font-size-m);
  }
  .main {
    flex-grow: 1;
  }
</style>
