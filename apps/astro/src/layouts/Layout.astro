---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import PageLoader from '@/components/PageLoader.astro'
import Sidebar from '@/components/Sidebar.astro'
import { getLocaleFromPath } from '@app/api/i18n'

import type { Meta, PageSlug } from '@app/api/types'
import { getGeneral } from '@/lib/page'

type Props = {
  meta: Meta
  noGeneral?: boolean
  slug?: PageSlug
  parentSlug?: PageSlug
}

const { meta, slug, noGeneral } = Astro.props

const locale = getLocaleFromPath(Astro.url.pathname)
const general = !noGeneral ? await getGeneral(locale.code) : null

const navigation = general?.navigation ?? undefined
const footer = general?.footer ?? undefined
---

<!doctype html>
<html lang="en">
  <Head meta={meta} />
  <body data-theme="light" class="body" data-slug={slug}>
    <div class="container">
      <div class="content">
        <div class="content__inner">
          <Sidebar navigation={navigation} slug={slug} />
          <main class="main">
            <slot />
          </main>
        </div>
      </div>
      <Footer {...footer} routes={general?.routes} />
    </div>
    <PageLoader />
  </body>
</html>

<script>
  import { initScrollHash, initScrollClicks } from '@/lib/scroll'
  document.addEventListener('astro:page-load', () => {
    initScrollHash()
  })

  initScrollClicks()
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  html,
  body {
    background-color: var(--color-teal-00);
    color: var(--body-color);
    @include font();
    height: 100%;
    font-size: var(--font-size-m);
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    position: relative;
  }

  .container {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: stretch;
    overflow-x: clip;
    font-size: var(--font-size-m);
  }

  .content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: center;

    &__inner {
      display: flex;
      flex-direction: row;
      max-width: var(--layout-max-width);
      width: 100%;
    }
  }

  .main {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
</style>
