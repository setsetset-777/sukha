---
import type { Partner, Project } from '@app/api/types'
import Image from '@/components/Image.astro'
import Action from '@/components/Action.astro'
import TagList from '@/components/TagList.astro'
import Gallery from '@/components/Gallery.astro'
import ProjectNext from '@/components/ProjectNext.astro'

type Props = Project.Data

const { title, image, place, tags, text, backLink, gallery, existing, specs, credit, next } =
  Astro.props

const { search } = Astro.url
let backUrl = search && backLink?.url ? backLink?.url + search : backLink?.url
---

<div class="page">
  <section class="hero">
    <div class="header">
      <h1 class="title">{title}</h1>
    </div>

    <div class="image">
      {image && (
        <Image
          src={image.url}
          alt={image.alt}
          srcset={{
            '1200w': image.sizes?.[2000]?.url!,
            '2400w': image.sizes?.[3000]?.url!,
          }}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          width={image.width}
          height={image.height}
          fit="contain"
          credit={image.credit as Partner}
        />
      )}
    </div>
  </section>
  <div class="body">
    <section class="info" data-scroll-view="next">
      <div class="info__header">
        {place && <h3 class="place">{place}</h3>}

        <TagList tags={tags} />
      </div>
      <div class="info__content">{text && <div class="text" set:html={text} />}</div>
      <div class="info__footer">
        {backLink && <Action label={backLink.label} href={backLink.url} type="left" />}
      </div>
    </section>

    <Gallery images={gallery} credit={credit} />

    {existing && existing.images.length > 0 && (
      <section class="existing" data-scroll-view="next">
        <h3 class="existing__title">{existing.label}</h3>
        <div class="existing__gallery">
          {existing.images.map(
            (image) =>
              image && (
                <div class="existing__image">
                  <Image
                    src={image.url}
                    alt={image.alt}
                    srcset={{
                      '600w': image.sizes?.[1000]?.url!,
                      '1200w': image.sizes?.[2000]?.url!,
                    }}
                    loading="lazy"
                    decoding="async"
                    fit="contain"
                    width={image.width}
                    height={image.height}
                    credit={image.credit as Partner}
                  />
                </div>
              ),
          )}
        </div>
      </section>
    )}

    {specs && specs.list && specs.list.length > 0 && (
      <section class="specs" data-scroll-view="next">
        <h3 class="specs__title">{specs.label}</h3>
        <dl class="specs__list">
          {specs.list.map(({ label, values }) => (
            <div class="specs__part">
              <dt>{label}</dt>
              <div>
                {values?.map((value) => (
                  <dd>{value}</dd>
                ))}
              </div>
            </div>
          ))}
        </dl>
      </section>
    )}

    <section class="footer">
      {backLink && <Action label={backLink.label} href={backUrl} type="left" />}
      {next && <ProjectNext {...next} />}
    </section>
  </div>
</div>

<style lang="scss">
  @use '../styles/utilities' as *;

  .page {
    --section-gap: var(--space-24);

    padding: var(--page-padding);
    display: flex;
    flex-direction: column;
    gap: var(--page-gap);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--page-content-gap);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--page-content-gap);
  }

  .title {
    @include heading(1);
  }

  .image {
    @include bleed;
    padding-bottom: var(--section-padding-bottom);
    max-height: 100dvh;
    border-radius: var(--radius-1);
    overflow: hidden;

    :global(img) {
      position: relative;
    }
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    align-items: start;
    max-width: #{pxToRem(600px)};

    &__header {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      align-items: start;
    }
  }

  .place {
    @include heading(3);
    color: var(--body-color);
  }

  .existing {
    --image-background-color: var(--color-teal-300);
    --image-height: auto;
    --image-width: 100%;

    display: flex;
    flex-wrap: wrap;
    gap: var(--section-gap);

    &__title {
      @include heading(2);
    }

    &__gallery {
      @include bleed();
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-24);
      padding-bottom: var(--section-padding-bottom);
      width: 100%;
    }

    &__image {
      position: relative;
      mix-blend-mode: luminosity;
      filter: grayscale(1);
      width: var(--image-width);
      height: var(--image-height);
    }
  }

  .specs {
    --columns: unset;
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);

    &__title {
      @include heading(2);
    }

    &__list {
      columns: var(--columns);
      column-gap: var(--grid-gap);
      row-gap: var(--grid-gap);
      max-width: pxToRem(900px);
      column-fill: balance;
    }

    &__part {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      display: flex;
      break-inside: avoid-column;
      margin-block-end: var(--space-24);
    }

    dt {
      font-weight: var(--font-weight-bold);
    }

    dd {
      margin: 0;
    }
  }

  .footer {
    display: flex;
    flex-direction: column-reverse;
    row-gap: var(--space-48);
    column-gap: var(--space-48);
    align-items: start;
  }

  @include from(big-mobile) {
    .specs {
      --columns: 2;
    }

    .existing {
      --image-height: #{pxToRem(360px)};
      --image-width: auto;
    }

    .footer {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  @include from(desktop) {
    .specs {
      --columns: 3;
    }
  }
</style>
