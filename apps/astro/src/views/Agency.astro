---
import type { Agency, Partner } from '@app/api/types'
import Image from '@/components/Image.astro'

type Props = Agency.Data

const { title, image, name, job, text, partners } = Astro.props
---

<div class="page">
  <section class="header">
    <h1 class="title">{title}</h1>
  </section>
  <div class="body">
    <section class="hero" data-scroll-view>
      <div class="hero__inner">
        <div class="image">
          {image && (
            <Image
              src={image.url}
              alt={image.alt}
              srcset={{
                '600w': image.sizes?.[1000]?.url!,
                '1200w': image.sizes?.[2000]?.url!,
              }}
              fetchpriority="high"
              loading="eager"
              decoding="async"
              fit="contain"
              width={image.width}
              height={image.height}
              credit={image.credit as Partner}
            />
          )}
        </div>
        <div class="info">
          {name && <h3 class="name">{name}</h3>}
          {job && <h4 class="job">{job}</h4>}
        </div>
      </div>
    </section>

    {text && (
      <section class="text" data-scroll-view>
        <div class="text__inner" set:html={text} />
      </section>
    )}

    {partners.list.length > 0 && (
      <section class="partners" data-scroll-view>
        <h3 class="partners__title">
          <span>{partners.title}</span>
        </h3>
        <div class="partners__list">
          {partners.list.map(({ name, job, url, text }) => (
            <article class="partner">
              <div class="partner__header">
                <h4 class="partner__name">{name}</h4>
                {job && <h5 class="partner__job">{job}</h5>}
              </div>
              <div class="partner__body">
                {text && <div class="partner__text" set:html={text} />}
                {url && (
                  <a class="partner__link" href={url}>
                    {url}
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</div>

<style lang="scss">
  @use '../styles/utilities' as *;

  .page {
    --grid-column-left-width: #{pxToRem(240px)};
    --base-gap: var(--space-48);
    --section-gap: var(--space-64);

    padding-top: var(--content-padding-top);
    padding-bottom: var(--content-padding-bottom);
    display: flex;
    flex-direction: column;
    gap: var(--page-gap);

    .body {
      display: flex;
      flex-direction: column;
      gap: var(--section-gap);
    }

    .title {
      @include heading(1);
    }

    .hero {
      position: relative;
      @include bleed(dark);

      &__inner {
        position: relative;
        display: flex;
        flex-direction: row;
        gap: var(--base-gap);
        align-items: end;
        padding-bottom: var(--space-48);
        padding-right: var(--layout-padding-x);
      }
    }

    .image {
      width: pxToRem(420px);
      --image-background-color: var(--color-teal-700);
    }

    .info {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .name {
      @include heading(2);
      color: var(--color-teal-50);
    }

    .job {
      color: var(--color-teal-200);
    }

    .grid {
      display: grid;
      grid-template-columns: var(--grid-column-left-width) 1fr;
      gap: var(--base-gap);
    }

    .text {
      @extend .grid;
      padding-right: var(--layout-padding-x);

      &__inner {
        grid-column-start: 2;
        max-width: pxToRem(640px);
      }
    }

    .partners {
      display: flex;
      flex-direction: column;
      gap: var(--base-gap);

      &__title {
        @extend .grid;
        @include heading(2);

        span {
          grid-column-start: 2;
        }
      }

      &__list {
        display: flex;
        flex-direction: column;
        gap: var(--base-gap);
      }
    }

    .partner {
      @extend .grid;

      &__header {
        display: flex;
        flex-direction: column;
        align-items: end;
        gap: var(--space-4);
      }

      &__name {
        @include heading(3);
      }

      &__job {
        color: var(--color-teal-600);
      }

      &__body {
        max-width: pxToRem(400px);
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
      }

      &__link {
        color: var(--color-teal-600);
        @include transition(color);

        &:hover {
          color: var(--body-color);
        }
      }
    }
  }
</style>
