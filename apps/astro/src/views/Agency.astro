---
import type { Agency, Partner } from '@app/api/types'
import Image from '@/components/Image.astro'
import Credit from '@/components/Credit.astro'

type Props = Agency.Data

const { title, sukha, founder, partners } = Astro.props

const imageCredit = founder.image && founder.image.credit && (founder.image.credit as Partner)
---

<div class="page">
  <section class="header">
    <h1 class="title">{title}</h1>
  </section>
  <div class="body">
    <section class="sukha" data-scroll-view="next">
      <div class="sukha__content">
        {sukha.title && <h3 class="sukha__title">{sukha.title}</h3>}
        {sukha.text && <div class="sukha__text" set:html={sukha.text} />}
      </div>
      <div class="sukha__callout">
        {sukha.callout && <div class="sukha__callout">{sukha.callout}</div>}
      </div>
    </section>

    <section class="founder" data-scroll-view="next">
      <div class="founder__inner">
        <div class="founder__image">
          {founder.image && (
            <Image
              src={founder.image.url}
              alt={founder.image.alt}
              srcset={{
                '600w': founder.image.sizes?.[1000]?.url!,
                '1200w': founder.image.sizes?.[2000]?.url!,
              }}
              fetchpriority="high"
              loading="eager"
              decoding="async"
              fit="contain"
              width={founder.image.width}
              height={founder.image.height}
            />
          )}
          {imageCredit && <Credit {...imageCredit} />}
        </div>
        <div class="founder__content">
          <div class="founder__info">
            {founder.name && <h3 class="founder__name">{founder.name}</h3>}
            {founder.job && <h4 class="founder__job">{founder.job}</h4>}
          </div>
          {founder.text && <div class="founder__text" set:html={founder.text} />}
        </div>
      </div>
    </section>

    {partners.list.length > 0 && (
      <section class="partners" data-scroll-view="next">
        <h3 class="partners__title">
          <span>{partners.title}</span>
        </h3>
        <div class="partners__list">
          {partners.list.map(({ name, job, url, text }) => (
            <article class="partner">
              <div class="partner__header">
                <h4 class="partner__name">{name}</h4>
                {job && <h5 class="partner__job">{job}</h5>}
              </div>
              <div class="partner__body">
                {text && <div class="partner__text" set:html={text} />}
                {url && (
                  <a class="partner__link" href={url}>
                    {url}
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</div>

<style lang="scss">
  @use '../styles/utilities' as *;

  .page {
    --grid-column-left-width: #{pxToRem(240px)};
    --base-gap: var(--space-48);
    --image-width: #{pxToRem(420px)};
    --partner-gap: var(--space-48);
    --partner-list-gap: var(--space-48);
    --columns: 1;
    --sukha-body-grid-col: span 1;
    --sukha-callout-grid-col: span 1;
    --founder-image-grid-col: span 1;
    --founder-content-grid-col: span 1;
    --partner-header-grid-col: span 1;
    --partner-body-grid-col: span 1;
    --founder-content-padding-left: var(--space-24);
    --max-width-text: #{pxToRem(600px)};
    --max-width-callout: #{pxToRem(400px)};
    --partner-header-align: start;

    padding: var(--page-padding);
    display: flex;
    flex-direction: column;
    gap: var(--page-gap);

    .body {
      display: flex;
      flex-direction: column;
      gap: var(--page-content-gap);
    }

    .title {
      @include heading(1);
    }

    .sukha {
      @include grid(#{var(--columns)});
      row-gap: var(--page-content-gap);

      &__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        grid-column: var(--sukha-body-grid-col);
        max-width: var(--max-width-text);
      }

      &__title {
        @include heading(2);
      }

      &__callout {
        @include heading(3);
        grid-column: var(--sukha-callout-grid-col);
        max-width: var(--max-width-callout);
      }
    }

    .founder {
      @include bleed(dark);

      &__inner {
        @include grid(#{var(--columns)});
        row-gap: var(--space-24);
        position: relative;
        padding-bottom: var(--space-48);
      }

      &__image {
        --image-background-color: var(--color-teal-700);
        max-width: var(--image-width);
        position: relative;
        grid-column: var(--founder-image-grid-col);
        align-self: start;

        :global(img) {
          border-radius: var(--radius-1);
          overflow: hidden;
        }
      }

      &__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        grid-column: var(--founder-content-grid-col);
        padding-left: var(--founder-content-padding-left);
        padding-top: var(--space-48);
        max-width: var(--max-width-text);
        justify-content: end;
      }

      &__info {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
      }

      &__name {
        @include heading(2);
        color: var(--color-teal-50);
      }

      &__job {
        color: var(--color-teal-200);
      }

      &__text {
        color: var(--color-teal-50);
      }
    }

    .partners {
      display: flex;
      flex-direction: column;
      gap: var(--partner-gap);

      &__title {
        @include grid(#{var(--columns)});
        @include heading(2);

        span {
          grid-column: var(--partner-body-grid-col);
        }
      }

      &__list {
        display: flex;
        flex-direction: column;
        gap: var(--partner-list-gap);
      }
    }

    .partner {
      @include grid(#{var(--columns)});
      row-gap: var(--space-24);

      &__header {
        display: flex;
        flex-direction: column;
        align-items: var(--partner-header-align);
        gap: var(--space-4);
        grid-column: var(--partner-header-grid-col);
      }

      &__name {
        @include heading(3);
      }

      &__job {
        color: var(--color-teal-600);
      }

      &__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        grid-column: var(--partner-body-grid-col);
        max-width: var(--max-width-text);
      }

      &__link {
        color: var(--color-teal-600);
        @include transition(color);

        &:hover {
          color: var(--body-color);
        }
      }
    }

    @include from(big-mobile) {
      --columns: 12;
      --sukha-body-grid-col: 3 / span 7;
      --sukha-callout-grid-col: 2 / span 6;
      --founder-image-grid-col: span 5;
      --founder-content-grid-col: 6 / span 6;
      --partner-header-grid-col: span 3;
      --partner-body-grid-col: 4 / span 6;
      --partner-header-align: end;
      --founder-content-padding-left: 0;
    }

    @include from(desktop) {
      --sukha-callout-grid-col: 2 / span 6;
      --sukha-body-grid-col: 3 / span 7;
      --founder-image-grid-col: span 4;
      --founder-content-grid-col: 5 / span 5;
      --partner-body-grid-col: 4 / span 5;
      --partner-gap: var(--space-48);
      --partner-list-gap: var(--space-48);
      --max-width-text: auto;
      --max-width-callout: auto;
    }

    @include from(big-desktop) {
      --sukha-body-grid-col: 3 / span 6;
      --sukha-callout-grid-col: 2 / span 5;
    }
  }
</style>
